flowchart TD
    subgraph "Entry"
        Main["__main__ / app.main()"]:::infra
        Single(["single-instance guard — mutex/flock + activate ping (localhost:52697)"]):::infra
    end

    subgraph "Core"
        App("App — state machine idle/recording/processing"):::backend
        Events(["event queue (App.post)"]):::queue
        Poll("QTimer poll (main thread, 100ms)"):::backend
        Config[("config.json (DEFAULTS)")]:::database
        Net["netutil — insecure-SSL switch (corporate proxy)"]:::infra
    end

    subgraph "Input and UI (Qt main thread)"
        Hotkeys("Hotkeys — two global hotkeys (mic + system audio), pynput"):::frontend
        Tray("Tray — QSystemTrayIcon"):::frontend
        Overlay("Overlay + VoiceMicWidget"):::frontend
        Settings("SettingsWindow — main window: Home hub + settings pages"):::frontend
        Home("HomePage — live state, quick actions, recent transcripts"):::frontend
        Onboarding("OnboardingWizard — first-run setup"):::frontend
        Theme["theme / icons / glyphs / qtutil / keymap / widgets / choices"]:::frontend
    end

    subgraph "Processing (worker threads)"
        Recorder("Recorder — sounddevice (microphone or loopback input)"):::backend
        PortAudio("portaudio — which PortAudio answers: bundle dir onto PATH, then probe what loaded"):::infra
        SysAudio("system_audio — rank/resolve the loopback device, refuse the take when there is none"):::backend
        Resample("Resampler — native format → 16 kHz mono, in the capture callback"):::backend
        Transcriber("Transcriber — faster-whisper"):::backend
        TranscriberOV("OpenVinoTranscriber — OpenVINO GenAI (Intel GPU/NPU)"):::backend
        TranscriberPK("ParakeetTranscriber — NVIDIA Parakeet TDT via onnx-asr"):::backend
        Fillers("fillers — is the whole transcript one of the invented silence phrases?"):::backend
        Assistant("Assistant — LLM post-process (one profile per source)"):::backend
        Injector("Injector — paste/type at cursor"):::backend
        LiveType("LiveTyper — live typing while recording"):::backend
        Mute("MuteIntegrations — mute other apps"):::backend
        Diag("DiagnosticsEngine — settings self-tests"):::backend
        Progress("DownloadWatcher — model download byte progress"):::backend
    end

    subgraph "Persistence"
        History[("history.json — text only")]:::database
        Autostart["autostart — start with OS"]:::infra
        Updater("Updater — GitHub Releases"):::backend
    end

    subgraph "External"
        HF{{"Hugging Face — model download"}}:::external
        LLM{{"OpenAI-compatible API (Ollama, ...)"}}:::external
        GH{{"GitHub Releases API"}}:::external
        OS{{"Focused window / other apps"}}:::external
        Loopback{{"Loopback / monitor input device — 'Monitor of …', Stereo Mix, BlackHole, '… [Loopback]'"}}:::external
        PaDll{{"portaudio.dll — built with WASAPI loopback, bundled in the one-file exe; else the sounddevice wheel's own"}}:::external
    end

    Main -->|"acquire"| Single
    Single -->|"post activate (second launch)"| Events
    Main -->|"prepare_library_path() — first statement, prepends sys._MEIPASS to PATH"| PortAudio
    Main -->|"run"| App
    App --> Config
    App -->|"apply insecure_ssl (verify= + HF backend)"| Net
    App --> Poll
    Poll -->|"drain"| Events

    Hotkeys -->|"post press/release"| Events
    Tray -->|"post toggle/settings/quit"| Events
    Overlay -->|"post toggle/cancel"| Events
    Settings -->|"apply_settings"| App
    App --> Tray
    App --> Overlay
    App --> Settings
    App -->|"first run (no config yet)"| Onboarding
    Onboarding -->|"essential settings"| Config
    Settings -->|"first page; set_app_state mirrors state"| Home
    Home -->|"post toggle/cancel"| Events
    Overlay --- Theme
    Settings --- Theme

    App -->|"start/stop (microphone take)"| Recorder
    App -->|"system-audio take: which device?"| SysAudio
    SysAudio -->|"loopback input index"| Recorder
    SysAudio -->|"no candidate → refuse: (None, the platform fix)"| App
    App -->|"post notify (the refusal, forced)"| Events
    PortAudio -->|"decides which binary sounddevice resolves"| PaDll
    PaDll -->|"WASAPI loopback: every output is enumerated again as an input"| Loopback
    Recorder -->|"log_once(): loaded path, loopback support, device counts"| PortAudio
    Loopback -->|"what the computer plays"| Recorder
    Recorder -->|"downmix + resample per block"| Resample
    App -->|"_process worker"| Transcriber
    App -->|"backend = openvino (factory)"| TranscriberOV
    App -->|"backend = parakeet (factory)"| TranscriberPK
    Recorder -->|"audio frames"| Transcriber
    Recorder -->|"audio frames"| TranscriberOV
    Recorder -->|"audio frames"| TranscriberPK
    App -->|"silent/quiet audio + whole transcript = a listed phrase → drop the take"| Fillers
    App -->|"clip_stats verdict (silent/quiet/ok) for a take with no text"| Diag
    Transcriber -->|"text"| Assistant
    Assistant -->|"cleaned text"| Injector
    Transcriber -->|"text (assistant off)"| Injector
    App -->|"on record start/stop"| Mute
    App -->|"live typing worker (per take)"| LiveType
    Recorder -->|"uncommitted audio"| LiveType
    LiveType -->|"preview_segments"| Transcriber
    LiveType -->|"type stable text"| Injector

    Settings -->|"loopback candidates for the device list"| SysAudio
    Settings -->|"input profiles + list_output_devices() for the two-group picker and its hint"| Recorder
    Settings -->|"phrase-list status while it is edited"| Fillers
    Settings -->|"model download / mic + transcription test"| Diag
    Diag -->|"test clip"| Recorder
    Diag -->|"snapshot transcriber"| Transcriber
    Diag -->|"snapshot transcriber"| TranscriberOV
    Diag -->|"snapshot transcriber"| TranscriberPK

    Injector -->|"insert at cursor"| OS
    Mute -->|"synthesize mute keybind"| OS
    Transcriber -->|"first-use download"| HF
    TranscriberOV -->|"first-use download (OpenVINO IR)"| HF
    TranscriberPK -->|"first-use download (ONNX)"| HF
    Assistant -->|"chat/completions"| LLM
    Updater -->|"check/download"| GH
    Updater -->|"verify="| Net
    Assistant -->|"verify="| Net
    App --> Updater
    Transcriber -->|"watch download"| Progress
    TranscriberOV -->|"watch download"| Progress
    TranscriberPK -->|"watch download"| Progress
    Progress -->|"post progress (%)"| Events
    Updater -->|"post progress (%)"| Events
    App -->|"record text"| History
    App --> Autostart

